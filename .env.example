DATABASE_URL=postgres://localhost:5432/pengtou
WECHAT_APP_ID=wx066bf055f6b9d415
WECHAT_APP_SECRET=
# 小程序码目标版本：正式 release；未发布本地测试可用 develop；体验版用 trial。
WECHAT_MINIAPP_ENV=release
# Mobile 环境变量放 apps/mobile/.env；真机使用电脑局域网 IP，正式环境用 HTTPS。
EXPO_PUBLIC_API_URL=http://10.0.2.2:9001
# 小程序命令前设置此变量，真机使用 HTTPS 或开发工具允许的局域网地址。
TARO_APP_API_URL=http://127.0.0.1:9001
# 仅显式启用的本地开发使用；生产禁止。
ALLOW_DEV_AUTH=false
TARO_APP_DEV_AUTH=false
# 集成测试会在此实例创建并清理独立测试数据库，需要 CREATEDB 权限。
TEST_DATABASE_URL=postgres://localhost:5432/postgres
ANDROID_PACKAGE=com.xixisys.pengtou
# 仅供本机 pnpm ai:test 验证，倾盖如故后端不读取。禁止使用 EXPO_PUBLIC_ 前缀或打包到 App。
DASHSCOPE_API_KEY=
# 产品内 BYOK 仍仅在手机设置页填写并保存到 SecureStore。

# 官网 Android 下载：GitCode 公开仓库的 Release 附件，不经网站服务器中转。
GITCODE_OWNER=xixisys
GITCODE_REPO=qinggairugu-releases
# 发布 APK 需要 Token；公开仓库查询通常可不填写。只放服务端，禁止 EXPO_PUBLIC_。
GITCODE_TOKEN=
