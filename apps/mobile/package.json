{
  "name": "@pengtou/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs 8082 expo start --dev-client --port 8082",
    "android": "node ../../scripts/dev.mjs 8082 expo run:android --port 8082",
    "build": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "android:prebuild": "expo prebuild --platform android"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "expo-router": "~58.0.23",
    "expo-audio": "~58.0.9",
    "expo-file-system": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-dev-client": "~58.0.14",
    "expo-status-bar": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-splash-screen": "~58.0.10",
    "expo-crypto": "~58.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "expo": "~58.0.14",
    "@pengtou/contracts": "workspace:*",
    "@pengtou/shared": "workspace:*",
    "@pengtou/design-tokens": "workspace:*",
    "@pengtou/ai": "workspace:*",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  }
}
