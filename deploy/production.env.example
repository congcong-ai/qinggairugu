PORT=
DATABASE_URL=postgresql://qinggai:替换密码@127.0.0.1:5432/qinggai
WECHAT_APP_ID=wx066bf055f6b9d415
WECHAT_APP_SECRET=
WECHAT_MINIAPP_ENV=release
ALLOW_DEV_AUTH=false
# 不在后端配置用户的百炼 Key。

# GitCode 从属仓库仅提供 APK 下载；源码以 GitHub 主仓库为准。
