{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@qinggairugu/ai#build": {
      "outputs": []
    },
    "@qinggairugu/contracts#build": {
      "outputs": []
    },
    "@qinggairugu/database#build": {
      "outputs": []
    },
    "@qinggairugu/shared#build": {
      "outputs": []
    },
    "@qinggairugu/design-tokens#build": {
      "outputs": []
    },
    "@qinggairugu/config#build": {
      "outputs": []
    }
  }
}
